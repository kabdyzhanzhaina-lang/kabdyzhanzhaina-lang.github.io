{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(css|js)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600, stale-while-revalidate=86400"
    }
   ]
  }
 ],
